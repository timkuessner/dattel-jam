[ext_resource type="VideoStream" uid="uid://58o7rptfm3yt" path="res://assets/video/Start_Video.ogv" id="2_aqbct"]
[ext_resource type="PackedScene" uid="uid://dyw7n5l2cssd3" path="res://scenes/fade_transition.tscn" id="4_r2s4q"]

[sub_resource type="GDScript" id="GDScript_aqbct"]
script/source = "extends Control

func _ready() -> void:
	$Fadetransition.show()
	$Fadetransition/AnimationPlayer.play(\"Fade_in\")
	$Fadetransition/AnimationPlayer.advance(0)
	$VideoStreamPlayer.play()


func _on_fade_timer_timeout() -> void:
	get_tree().change_scene_to_file(\"res://scenes/MainMenu.tscn\")


func _on_video_stream_player_finished() -> void:
	$Fadetransition.show()
	$Fadetransition/fade_timer.start()
	$Fadetransition/AnimationPlayer.play(\"Fade_out\")
"

